{
  "version": 1,
  "name": "corporate",
  "page": {
    "width_mm": 210,
    "height_mm": 297,
    "margins_mm": {
      "left": 22,
      "right": 22,
      "top": 22,
      "bottom": 22
    },
    "header_mm": 10,
    "footer_mm": 10
  },
  "fonts": {
    "body": "Calibri",
    "code": "Consolas",
    "fallbacks": {
      "Arial": "Liberation Sans",
      "Calibri": "Carlito",
      "Times New Roman": "Liberation Serif",
      "Consolas": "Liberation Mono"
    }
  },
  "palette": {
    "ink": "000000",
    "muted": "555555",
    "accent": "15364A",
    "table_header": "15364A",
    "table_header_text": "FFFFFF",
    "alternating_row": "EEF3F6",
    "border": "D9D9D9",
    "note_background": "F3F5F7"
  },
  "styles": {
    "Normal": {
      "font": "Calibri",
      "size_pt": 11,
      "line_spacing": 1.15,
      "before_pt": 0,
      "after_pt": 6,
      "color": "000000"
    },
    "Title": {
      "font": "Calibri",
      "size_pt": 30,
      "bold": true,
      "before_pt": 0,
      "after_pt": 12,
      "color": "000000",
      "keep_with_next": true
    },
    "Subtitle": {
      "font": "Calibri",
      "size_pt": 12,
      "before_pt": 0,
      "after_pt": 12,
      "color": "555555",
      "keep_with_next": true
    },
    "Caption": {
      "font": "Calibri",
      "size_pt": 10,
      "before_pt": 4,
      "after_pt": 8,
      "color": "555555"
    },
    "Metadata": {
      "font": "Calibri",
      "size_pt": 10,
      "before_pt": 0,
      "after_pt": 4,
      "color": "555555"
    },
    "Code Block": {
      "font": "Consolas",
      "size_pt": 10,
      "line_spacing": 1.05,
      "before_pt": 4,
      "after_pt": 8,
      "color": "000000"
    },
    "Table Text": {
      "font": "Calibri",
      "size_pt": 10,
      "line_spacing": 1.1,
      "before_pt": 0,
      "after_pt": 3,
      "color": "000000"
    },
    "Note": {
      "font": "Calibri",
      "size_pt": 10.5,
      "before_pt": 4,
      "after_pt": 8,
      "color": "333333"
    },
    "Heading 1": {
      "font": "Calibri",
      "size_pt": 22,
      "bold": true,
      "before_pt": 16,
      "after_pt": 8,
      "color": "000000",
      "keep_with_next": true
    },
    "Heading 2": {
      "font": "Calibri",
      "size_pt": 16,
      "bold": true,
      "before_pt": 14,
      "after_pt": 7,
      "color": "000000",
      "keep_with_next": true
    },
    "Heading 3": {
      "font": "Calibri",
      "size_pt": 12,
      "bold": true,
      "before_pt": 12,
      "after_pt": 6,
      "color": "000000",
      "keep_with_next": true
    },
    "Heading 4": {
      "font": "Calibri",
      "size_pt": 11,
      "bold": true,
      "before_pt": 10,
      "after_pt": 5,
      "color": "000000",
      "keep_with_next": true
    },
    "Heading 5": {
      "font": "Calibri",
      "size_pt": 11,
      "bold": true,
      "before_pt": 8,
      "after_pt": 4,
      "color": "000000",
      "keep_with_next": true
    },
    "Heading 6": {
      "font": "Calibri",
      "size_pt": 10.5,
      "bold": true,
      "before_pt": 6,
      "after_pt": 3,
      "color": "000000",
      "keep_with_next": true
    }
  },
  "table": {
    "padding_mm": {
      "top": 2,
      "bottom": 2,
      "left": 2.5,
      "right": 2.5
    },
    "border_pt": 0.5,
    "repeat_header": true
  },
  "list": {
    "indent_mm": 8,
    "hanging_mm": 5,
    "level_step_mm": 6,
    "after_pt": 4
  },
  "footer": {
    "size_pt": 9,
    "color": "666666"
  }
}
